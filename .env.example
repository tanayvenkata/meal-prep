# Local-only template. Copy to .env.local; never paste production values here.
# pnpm dev uses Doppler meal-prep/dev, whose process variables take precedence.
# See docs/environments.md for hosted configuration and README.md for setup.

# Local Supabase SQL and Auth must refer to the same local instance.
# Get the local publishable key from `supabase status`; do not use a hosted key.
DATABASE_URL=postgresql://mise_app:mise_app_local@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-publishable-key

# Local fixture/setup connection only; never use this role for application SQL.
# Vitest pins both database URLs directly in vitest.config.ts.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional model evaluations only (not required by the website or MCP server).
# Supply OPENAI_API_KEY via your shell or Doppler when running eval:kitchen.

# Social sign-in: Doppler meal-prep/dev, injected into `supabase start`.
# Never prefix the client secrets with NEXT_PUBLIC_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-client-secret

# Optional remote observability. Store production values in Doppler / Worker secrets.
# Base URL, including /otlp when supplied by Grafana; no /v1/traces suffix here.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-REGION.grafana.net/otlp
# Percent-encode header values. Never prefix these settings with NEXT_PUBLIC_.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_INSTANCE_ID_AND_TOKEN
# Optional per-signal complete URLs and headers override the common settings:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20TOKEN
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://collector.example/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Bearer%20TOKEN
# MISE_ENVIRONMENT=development
# MISE_RELEASE=<full-git-commit-sha> # Worker releases; Vercel uses its commit SHA.

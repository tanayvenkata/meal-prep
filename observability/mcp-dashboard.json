{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Mise MCP operations",
  "uid": "mise-mcp-operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "mise",
    "mcp"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool calls by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mise_operation, mise_outcome) (rate(mise_kitchen_operations_total{mise_layer=\"tool\"}[$__rate_interval]))",
          "legendFormat": "{{mise_operation}} {{mise_outcome}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tool latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, mise_operation) (rate(mise_kitchen_duration_seconds_bucket{mise_layer=\"tool\"}[$__rate_interval])))",
          "legendFormat": "{{mise_operation}} {{mise_outcome}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP requests by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(mise_mcp_requests_total[$__rate_interval]))",
          "legendFormat": "{{mise_operation}} {{mise_outcome}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Command outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mise_operation, mise_outcome) (rate(mise_kitchen_operations_total{mise_layer=\"command\"}[$__rate_interval]))",
          "legendFormat": "{{mise_operation}} {{mise_outcome}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Latest exported tool counters",
      "description": "Sum of the latest samples from active instances, not a lifetime call total. Useful for low-volume serverless traffic where rate panels need more samples.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mise_operation, mise_outcome) (mise_kitchen_operations_total{mise_layer=\"tool\"})",
          "instant": true,
          "legendFormat": "{{mise_operation}} \u00b7 {{mise_outcome}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ],
  "description": "Semantic outcomes and timings. HTTP 200 does not prove a write applied. Rates require multiple samples; inspect traces for short-lived instances. See docs/OBSERVABILITY.md."
}
